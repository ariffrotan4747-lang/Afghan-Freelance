# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# HESABPAY PAYMENT GATEWAY (Official API Integration)
# Official production URL: https://api.hesab.com/api/v1/payment/create-session
# Official sandbox URL: https://api-sandbox.hesab.com/api/v1/payment/create-session
HESABPAY_API_KEY=
HESABPAY_API_URL="https://api-sandbox.hesab.com"
HESABPAY_WEBHOOK_SECRET=

# FIREBASE CONFIGURATION (For cloud persistence and auth)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

